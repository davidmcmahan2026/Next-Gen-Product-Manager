{
  "name": "dataclean-studio-bolt-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Bolt backend for DataClean Studio — deterministic tools Cleo (running in Relevance AI) calls over HTTP, plus the internal upload/export endpoints Cleo never sees.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.0.1",
    "papaparse": "^5.4.1",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.2",
    "@types/papaparse": "^5.3.14",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5"
  }
}
