# Port the Express server listens on.
PORT=8787

# Shared secret Relevance AI must send on every call to /api/tools/*.
# Generate a long random value (e.g. `openssl rand -hex 32`) and paste the
# SAME value into each Tool's headers in Relevance AI (see relevance-ai/tools.json).
# This proves the caller is Cleo's Relevance AI agent — it does NOT by itself
# authorize a gated action. Gated actions (execute_rules_engine, save_workflow)
# additionally require a human approval record in the database — see
# src/routes/approvals.ts and the "two locks" note in README.md.
RELEVANCE_TOOL_SECRET=replace-with-a-long-random-value

# Origin(s) allowed to call the human-facing endpoints (/api/approvals,
# /api/upload, /api/export) from the browser — set this to wherever the
# Upload / Review & Approve / Audit & Export screens are served from.
FRONTEND_ORIGIN=http://localhost:5173

# --- Relevance AI connection (see relevance-ai/cleo-agent-config.md #2) ---

# Your own Relevance AI API key — from Integrations & API Keys > Relevance
# API Keys in the Relevance AI UI. Lets THIS backend start a Cleo run.
# Shown once at creation; copy it immediately.
RELEVANCE_AI_API_KEY=replace-with-your-relevance-ai-api-key

# Cleo's agent id and its API trigger URL — both shown on the agent's own
# Triggers tab in Relevance AI once you've added an API trigger.
RELEVANCE_CLEO_AGENT_ID=replace-with-cleo-agent-id
RELEVANCE_TRIGGER_URL=replace-with-trigger-url-from-relevance-ai

# A secret YOU generate and put in two places: here, and as the custom
# header on the trigger's destination/webhook config in Relevance AI.
# Authenticates POST /api/cleo/callback — Relevance AI delivering Cleo's
# finished result. Different secret from RELEVANCE_TOOL_SECRET above,
# since it authenticates a different direction/moment (end of run,
# not a mid-run tool call).
RELEVANCE_CALLBACK_SECRET=replace-with-a-second-long-random-value
